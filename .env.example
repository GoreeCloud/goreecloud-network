# Development-only server bind. Loopback is the safe default.
GOREECLOUD_NETWORK_ADDR=127.0.0.1:8080

# Web dashboard directory when running from a non-repository working directory.
GOREECLOUD_NETWORK_WEB_ROOT=apps/web

# Development control-plane state file. The directory/file are created with restrictive permissions when absent.
GOREECLOUD_NETWORK_DATA_FILE=var/network-state.json

# GoreeCloud Identity OAuth token-introspection consumer boundary.
# Leave the core trio below empty together to keep admin authentication fail-closed/unconfigured.
# Do not commit real client secrets. Non-loopback introspection endpoints must use HTTPS.
GOREECLOUD_NETWORK_IDENTITY_INTROSPECTION_URL=
GOREECLOUD_NETWORK_IDENTITY_CLIENT_ID=
GOREECLOUD_NETWORK_IDENTITY_CLIENT_SECRET=

# Optional additional token checks. Configure these when the Identity application registration has stable values.
GOREECLOUD_NETWORK_IDENTITY_EXPECTED_ISSUER=
GOREECLOUD_NETWORK_IDENTITY_EXPECTED_AUDIENCE=

# Application-specific authority required by the Network administrative boundary.
GOREECLOUD_NETWORK_IDENTITY_ADMIN_SCOPE=goreecloud.network.admin
