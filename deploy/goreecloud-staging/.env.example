# GoreeCloud Network isolated staging environment
# Copy to .env and keep the populated file out of Git.

COMPOSE_PROJECT_NAME=goreecloud-network-staging
STAGING_BIND_ADDRESS=127.0.0.1
STAGING_DOMAIN=network-staging.invalid
STAGING_DNS_DOMAIN=network-staging.invalid

# Exact images under test. Prefer immutable image@sha256 references.
GOREECLOUD_NETWORK_MANAGEMENT_IMAGE=
GOREECLOUD_NETWORK_SIGNAL_IMAGE=
GOREECLOUD_NETWORK_RELAY_IMAGE=
GOREECLOUD_NETWORK_DASHBOARD_IMAGE=
GOREECLOUD_NETWORK_COTURN_IMAGE=

# Host ports reserved only for staging.
STAGING_DASHBOARD_HTTP_PORT=18080
STAGING_DASHBOARD_HTTPS_PORT=18443
STAGING_MANAGEMENT_PORT=13300
STAGING_SIGNAL_PORT=10000
STAGING_RELAY_PORT=13301
STAGING_TURN_PORT=13478

# Management and signaling endpoints visible to the staging clients.
STAGING_MANAGEMENT_ENDPOINT=https://network-staging.invalid:18443
STAGING_SIGNAL_ENDPOINT=network-staging.invalid:10000
STAGING_RELAY_ENDPOINT=rel://network-staging.invalid:13301
STAGING_TURN_ENDPOINT=network-staging.invalid:13478

# OIDC values must refer only to an approved staging identity client/realm.
STAGING_AUTH_AUDIENCE=
STAGING_AUTH_CLIENT_ID=
STAGING_AUTH_CLIENT_SECRET=
STAGING_AUTH_AUTHORITY=
STAGING_AUTH_JWT_CERTS=
STAGING_AUTH_TOKEN_ENDPOINT=
STAGING_AUTH_DEVICE_AUTH_ENDPOINT=
STAGING_AUTH_DEVICE_AUTH_CLIENT_ID=
STAGING_AUTH_DEVICE_AUTH_SCOPE=openid
STAGING_AUTH_PKCE_AUTHORIZATION_ENDPOINT=
STAGING_AUTH_PKCE_REDIRECT_URLS=
STAGING_AUTH_SUPPORTED_SCOPES=openid profile email offline_access
STAGING_AUTH_USER_ID_CLAIM=sub

# Management-side identity-provider client. Staging credentials only.
STAGING_IDP_MANAGER_TYPE=none
STAGING_IDP_MGMT_CLIENT_ID=
STAGING_IDP_MGMT_CLIENT_SECRET=
STAGING_IDP_MGMT_EXTRA_CONFIG=null

# Sensitive values. Generate unique values for staging; never copy production secrets.
STAGING_DATASTORE_ENC_KEY=
STAGING_RELAY_AUTH_SECRET=
STAGING_TURN_USER=goreecloud-staging
STAGING_TURN_PASSWORD=

# Default policy is deliberately disabled so acceptance can prove explicit deny-by-default behavior.
STAGING_DISABLE_DEFAULT_POLICY=true

# Anonymous metrics remain disabled in GoreeCloud staging.
STAGING_DISABLE_ANONYMOUS_METRICS=true

# Store engine. SQLite is preferred for disposable isolated acceptance unless the test specifically targets another engine.
STAGING_STORE_ENGINE=sqlite
STAGING_POSTGRES_DSN=
STAGING_MYSQL_DSN=
